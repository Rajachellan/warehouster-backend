# Coolify → Environment Variables
NODE_ENV=production
PORT=9006
API_URL=https://api.warehouster.com
CLIENT_URL=https://admin.warehouster.com
FRONTEND_URL=https://warehouster.com
CORS_ORIGINS=https://admin.warehouster.com,https://warehouster.com,https://www.warehouster.com

MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/warehouster?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_REQUIRE_SIGNED_URLS=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Warehouster
SMTP_FROM_EMAIL=info@warehouster.com
ADMIN_EMAIL=info@warehouster.com

SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@warehouster.com
SEED_ADMIN_PASSWORD=ChangeMe123!
